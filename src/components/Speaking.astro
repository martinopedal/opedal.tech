---
type SessionizeSession = {
  id: number;
  title: string;
  description: string;
  sessionUrl: string;
  languageCode: string;
  language: string;
};

type SessionizePayload = {
  sessions?: SessionizeSession[];
};

const SESSIONIZE_API = 'https://sessionize.com/api/speaker/json/0q2vfif629';
let sessions: SessionizeSession[] = [];
try {
  const res = await fetch(SESSIONIZE_API, { signal: AbortSignal.timeout(10000) });
  if (res.ok) {
    const data = (await res.json()) as SessionizePayload;
    sessions = data.sessions ?? [];
  } else {
    console.warn(`[Speaking] Sessionize returned HTTP ${res.status}; session catalog hidden in this build.`);
  }
} catch (err) {
  const name = err instanceof Error ? err.name : 'error';
  console.warn(`[Speaking] Sessionize fetch failed (${name}); session catalog hidden in this build.`);
  sessions = [];
}
if (sessions.length === 0) {
  console.warn('[Speaking] Sessionize returned 0 sessions; session catalog hidden in this build.');
}

function summarise(text: string, max = 220): string {
  const clean = text.replace(/\r\n|\r|\n/g, ' ').replace(/\s+/g, ' ').trim();
  if (clean.length <= max) return clean;
  const cut = clean.slice(0, max);
  const lastSpace = cut.lastIndexOf(' ');
  return (lastSpace > 0 ? cut.slice(0, lastSpace) : cut) + '...';
}
---
<section id="speaking">
  <div class="container">
    <span class="section-label">Talks &amp; Training</span>
    <h2>Speaking</h2>
    <p class="speaking-line">
      Upcoming: <em>"Where does code generation stop and InfraOps start?"</em> at <a href="https://msevents.microsoft.com/event?id=1068023795" target="_blank" rel="noopener noreferrer">Agentic AI &amp; DevOps Days</a>, Oslo, June 16, 2026.
    </p>
    <p class="speaking-line">
      I have previously spoken at <a href="https://www.nicconf.com" target="_blank" rel="noopener noreferrer">Nordic Infrastructure Conference (NIC)</a> (one Level 300, live-streamed session on Terraform, GitHub Copilot, and IaC security, 94% approval), and at Microsoft customer sessions on GHAS, GitHub and Azure DevOps, and Azure Arc and Azure Local.
    </p>
    {sessions.length > 0 && (
      <div class="sessions">
        <h3 class="sessions-heading">Session catalog</h3>
        <p class="sessions-sub">
          Talks I am currently pitching. Full abstracts on <a href="https://sessionize.com/martin-opedal" target="_blank" rel="noopener noreferrer">Sessionize</a>.
        </p>
        <div class="sessions-list">
          {sessions.map((s) => (
            <a class="session-card" href={s.sessionUrl} target="_blank" rel="noopener noreferrer">
              <div class="session-card-meta">
                <span class="session-lang">{s.language}</span>
              </div>
              <h4 class="session-card-title">{s.title}</h4>
              <p class="session-card-desc">{summarise(s.description)}</p>
            </a>
          ))}
        </div>
      </div>
    )}
  </div>
</section>
